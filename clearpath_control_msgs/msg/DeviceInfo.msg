# Device identity and metadata

string device_id         # Unique component identifier within the robot
string device_class      # Device category, for example: camera, lidar, lidar2d.

string model             # Device model name
string manufacturer      # Device manufacturer
string firmware_version  # Firmware/Software or driver version associated with the component.
string hardware_version  # Hardware revision, if available.
string serial_number     # Device serial number
